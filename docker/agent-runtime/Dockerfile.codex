# syntax=docker/dockerfile:1.6
ARG BASE_TAG=dev
FROM paperclipinc/agent-runtime-base:${BASE_TAG}

# Pinned, not @latest. @latest resolves at build time, so the tag `v3` silently
# meant "whatever npm served on 2026-07-02" -- 63 releases behind by 2026-07-27.
# That gap is customer-visible: the model catalog gained gpt-5.6-luna on
# 2026-07-11, the 0.142.5 CLI baked into the image had no metadata for it, and
# every run for those agents opened with an item_0 of type "error" reading
# "Model metadata for `gpt-5.6-luna` not found. Defaulting to fallback
# metadata", which reads as a failed run to customers and to us.
ARG CODEX_VERSION=0.145.0

USER root
# The `|| true` is scoped to the chown ONLY. It used to cover the whole chain,
# which meant a failed `npm install` still produced a green build shipping the
# previously-baked CLI. That is how the drift above went unnoticed for 25 days:
# nothing ever failed loudly.
RUN npm install -g @openai/codex@${CODEX_VERSION} \
    && { chown -R 1000:1000 /usr/lib/node_modules || true; }

USER 1000:1000

# Verify the CLI is on PATH for the shim's exec.LookPath
RUN command -v codex >/dev/null 2>&1 || (echo "codex not on PATH"; exit 1)

# ...and that it is the version we pinned. A PATH check alone passes on a stale
# binary inherited from the base image, which is exactly the failure this file
# is meant to make impossible.
RUN codex --version 2>&1 | grep -qF "${CODEX_VERSION}" \
    || (echo "codex version mismatch: wanted ${CODEX_VERSION}, got $(codex --version 2>&1)"; exit 1)
